 .\n    . . e 2 2 2 2 2 2 . . .\n    . e . . . 8 8 8 8 . . .\n    e . . . . 8 . . 8 . . .\n    . . . . . . 8 . . 8 . .\n    . . . . . . f . . f . .\n    . . . . . . . 6 . . 6 .\n    . . . . . . . . 6 . . 6\n    . . . . . . . . 6 . . 6\n\"\"\")\n\n# Down arrow: crouched racing tuck + speed lines\nskier_fast = img(\"\"\"\n    . 9 . . . . . . . . 9 .\n    . 9 . . . . . . . . 9 .\n    . . . . . 5 5 . . . . .\n    . . . . 3 3 3 3 . . . .\n    . . . 2 d 8 8 d 2 . . .\n    . . 2 2 2 5 5 2 2 2 . .\n    . e 2 2 2 2 2 2 2 2 e .\n    e . . . 8 8 8 8 . . . e\n    . . . . 8 . . 8 . . . .\n    . . . . f . . f . . . .\n    . . . . 6 . . 6 . . . .\n    . . . . 6 . . 6 . . . .\n    . . . . 6 . . 6 . . . .\n    . . . . 6 . . 6 . . . .\n\"\"\")\n\n# Up arrow: snowplow (\"pizza\" wedge) + snow spray\nskier_slow = img(\"\"\"\n    . . . . . 5 5 . . . . .\n    . . . . 3 3 3 3 . . . .\n    . . . . d 8 8 d . . . .\n    . . . . . d d . . . . .\n    . 2 2 2 2 2 2 2 2 2 2 .\n    e . . 2 2 5 5 2 2 . . e\n    e . . . 2 2 2 2 . . . e\n    . . . . 8 8 8 8 . . . .\n    . . . 8 . . . . 8 . . .\n    . . . f . . . . f . . .\n    . . 6 . . . . . . 6 . .\n    . . . 6 . . . . 6 . . .\n    . 9 . . 6 . . 6 . . 9 .\n    . . 9 . . 6 6 . . 9 . .\n\"\"\")\n\ntree_img = img(\"\"\"\n    . . . . . . 7 7 . . . . . .\n    . . . . . 7 9 7 7 . . . . .\n    . . . . 7 7 7 7 7 7 . . . .\n    . . . . . 7 7 7 7 . . . . .\n    . . . . 7 9 7 7 7 7 . . . .\n    . . . 7 7 7 7 7 9 7 7 . . .\n    . . 7 7 7 7 7 7 7 7 7 7 . .\n    . . . . 7 7 7 7 7 7 . . . .\n    . . . 7 9 7 7 7 7 7 7 . . .\n    . . 7 7 7 7 7 7 9 7 7 7 . .\n    . 7 7 7 7 7 7 7 7 7 7 7 7 .\n    7 7 7 7 7 7 7 7 7 7 7 7 7 7\n    . . . . . . e e . . . . . .\n    . . . . . . e e . . . . . .\n    . . . . . . e e . . . . . .\n    . . . . . 9 9 9 9 . . . . .\n\"\"\")\n\nrock_img = img(\"\"\"\n    . . . . 9 9 9 9 . . . .\n    . . . 9 9 9 c c 9 . . .\n    . . c c c c c c c c . .\n    . c c b b c c c c c c .\n    . c b b c c c c f c c .\n    c c c c c c c f f c c c\n    c c c c c f f c c c f c\n    c c c f f c c c c f c c\n    . c c c c c c c c c c .\n    . . 9 9 9 9 9 9 9 9 . .\n\"\"\")\n\nflag_img = img(\"\"\"\n    . . f 4 4 4 4 . . .\n    . . f 4 5 5 4 4 . .\n    . . f 4 5 5 5 4 4 .\n    . . f 4 5 5 4 4 . .\n    . . f 4 4 4 4 . . .\n    . . f . . . . . . .\n    . . f . . . . . . .\n    . . f . . . . . . .\n    . . f . . . . . . .\n    . . f . . . . . . .\n    . . f . . . . . . .\n    . 9 9 9 . . . . . .\n\"\"\")\n\nsnow_streak_img = img(\"\"\"\n    9 .\n    9 .\n    9 .\n    . 9\n    . 9\n    . .\n\"\"\")\n\n# Checkered finish line banner (160x8)\nfinish_img = image.create(160, 8)\nfinish_img.fill(2)\nfor col in range(0, 160, 8):\n    finish_img.fill_rect(col, 0, 4, 4, 1)\n    finish_img.fill_rect(col + 4, 4, 4, 4, 1)\n\n# --- 2. GAME SETTINGS & STATE ---\n\nNORMAL_SPEED = 70\nSLOW_SPEED = 35\nFAST_SPEED = 125\nSTEER_SPEED = 85\nLEVEL_1_GOAL = 300  # Ski 300 meters to reach the finish line\n\nscroll_speed = NORMAL_SPEED\ndistance = 0.0\nlast_scored_meter = 0\nlast_time = game.runtime()\ninvincible_until = 0\nhalfway_announced = False\nfinish_spawned = False\nlevel_cleared = False\n\n# --- 3. SETUP SCENE & PLAYER ---\n\nscene.set_background_color(1)  # White snow\n\nskier = sprites.create(skier_straight, SpriteKind.player)\nskier.set_position(80, 38)\nskier.set_stay_in_screen(True)\nskier.z = 5\n\ninfo.set_life(3)\ninfo.set_score(0)\n\n# Helper to spawn a tree or rock at a given y\ndef create_hazard_at(y_pos):\n    if Math.percent_chance(70):\n        hazard = sprites.create(tree_img, SpriteKind.enemy)\n    else:\n        hazard = sprites.create(rock_img, SpriteKind.enemy)\n    hazard.set_position(randint(12, 148), y_pos)\n    hazard.vy = -scroll_speed\n    hazard.z = 2\n\n# Put a few starter objects on the slope right away\ncreate_hazard_at(95)\ncreate_hazard_at(115)\nfor i in range(6):\n    s = sprites.create(snow_streak_img, SpriteKind.projectile)\n    s.set_position(randint(4, 156), randint(10, 115))\n    s.vy = -scroll_speed\n    s.z = -1\n    s.set_flag(SpriteFlag.GHOST, True)\n\ngame.splash(\"FAMILY SKI TRIP!\", \"Level 1: Bunny Slope\")\ngame.show_long_text(\n    \"Left/Right: Steer\\nDown: Tuck (Fast)\\nUp: Snowplow (Slow)\\nAvoid trees & rocks!\\nGrab flags for +25 pts!\\nReach 300m to win!\",\n    DialogLayout.BOTTOM,\n)\nlast_time = game.runtime()\n\n# --- 4. MAIN GAME LOOP ---\n\ndef on_update_game():\n    global scroll_speed, distance, last_scored_meter, last_time\n    global halfway_announced, finish_spawned\n\n    if level_cleared:\n        return\n\n    now = game.runtime()\n    dt = (now - last_time) / 1000.0\n    last_time = now\n    if dt > 0.1:\n        dt = 0.1\n\n    # Speed control (Down = tuck fast, Up = snowplow slow)\n    target_y = 38\n    if controller.down.is_pressed():\n        scroll_speed = FAST_SPEED\n        target_y = 50\n    elif controller.up.is_pressed():\n        scroll_speed = SLOW_SPEED\n        target_y = 28\n    else:\n        scroll_speed = NORMAL_SPEED\n        target_y = 38\n\n    skier.y += (target_y - skier.y) * 0.18\n\n    # Left / Right steering + Up / Down pose animation\n    if controller.left.is_pressed():\n        skier.vx = -STEER_SPEED\n        skier.set_image(skier_left)\n    elif controller.right.is_pressed():\n        skier.vx = STEER_SPEED\n        skier.set_image(skier_right)\n    else:\n        skier.vx = 0\n        if controller.down.is_pressed():\n            skier.set_image(skier_fast)\n        elif controller.up.is_pressed():\n            skier.set_image(skier_slow)\n        else:\n            skier.set_image(skier_straight)\n\n    # Update speed & clean up objects once they scroll off the top\n    for hazard in sprites.all_of_kind(SpriteKind.enemy):\n        hazard.vy = -scroll_speed\n        if hazard.bottom < 0:\n            hazard.destroy()\n\n    for bonus in sprites.all_of_kind(SpriteKind.food):\n        bonus.vy = -scroll_speed\n        if bonus.bottom < 0:\n            bonus.destroy()\n\n    for streak in sprites.all_of_kind(SpriteKind.projectile):\n        streak.vy = -scroll_speed\n        if streak.bottom < 0:\n            streak.destroy()\n\n    for banner in sprites.all_of_kind(SpriteKind.Finish):\n        banner.vy = -scroll_speed\n\n    # Blink while briefly invincible after hitting a hazard\n    if now < invincible_until:\n        skier.set_flag(SpriteFlag.INVISIBLE, (now // 100) % 2 == 0)\n    else:\n        skier.set_flag(SpriteFlag.INVISIBLE, False)\n\n    # Track distance skied (10 pixels = 1 meter)\n    distance += (scroll_speed * dt) / 10.0\n    current_meter = int(distance)\n    if current_meter > last_scored_meter:\n        info.change_score_by(current_meter - last_scored_meter)\n        last_scored_meter = current_meter\n\n    # Milestone callout halfway through Level 1\n    if not halfway_announced and distance >= LEVEL_1_GOAL / 2:\n        halfway_announced = True\n        skier.say_text(\"Halfway!\", 1200)\n\n    # Spawn the checkered finish line at the goal!\n    if not finish_spawned and distance >= LEVEL_1_GOAL:\n        finish_spawned = True\n        skier.say_text(\"Lodge ahead!\", 1200)\n        finish_line = sprites.create(finish_img, SpriteKind.Finish)\n        finish_line.set_position(80, 126)\n        finish_line.vy = -scroll_speed\n        finish_line.z = 1\n\ngame.on_update(on_update_game)\n\n# --- 5. SPAWN HAZARDS, BONUS FLAGS & SNOW STREAKS ---\n\ndef spawn_hazard():\n    if level_cleared or finish_spawned:\n        return\n    create_hazard_at(128)\n\ngame.on_update_interval(650, spawn_hazard)\n\ndef spawn_flag():\n    if level_cleared or finish_spawned:\n        return\n    flag = sprites.create(flag_img, SpriteKind.food)\n    flag.set_position(randint(16, 144), 126)\n    flag.vy = -scroll_speed\n    flag.z = 2\n\ngame.on_update_interval(2200, spawn_flag)\n\ndef spawn_snow_streak():\n    if level_cleared:\n        return\n    streak = sprites.create(snow_streak_img, SpriteKind.projectile)\n    streak.set_position(randint(4, 156), 124)\n    streak.vy = -scroll_speed\n    streak.z = -1\n    streak.set_flag(SpriteFlag.GHOST, True)\n\ngame.on_update_interval(180, spawn_snow_streak)\n\n# --- 6. COLLISIONS ---\n\ndef on_hit_hazard(player_sprite, hazard_sprite):\n    global invincible_until\n\n    now = game.runtime()\n    if now < invincible_until:\n        return\n\n    hazard_sprite.destroy(effects.disintegrate, 200)\n    info.change_life_by(-1)\n    scene.camera_shake(4, 200)\n    music.knock.play()\n    invincible_until = now + 1200  # 1.2 seconds of grace time\n\nsprites.on_overlap(SpriteKind.player, SpriteKind.enemy, on_hit_hazard)\n\ndef on_collect_flag(player_sprite, flag_sprite):\n    flag_sprite.destroy(effects.hearts, 200)\n    info.change_score_by(25)\n    music.ba_ding.play()    \n\nsprites.on_overlap(SpriteKind.player, SpriteKind.food, on_collect_flag)\n\ndef on_cross_finish(player_sprite, finish_sprite):\n    global level_cleared\n\n    if level_cleared:\n        return\n    level_cleared = True\n    music.power_up.play()\n    game.splash(\"LEVEL 1 COMPLETE!\", \"Welcome to the Ski Lodge!\")\n    game.over(True, effects.confetti)\n\nsprites.on_overlap(SpriteKind.player, SpriteKind.Finish, on_cross_finish)"}]},{"timestamp":1795673949086,"editorVersion":"4.1.32","changes":[{"type":"edited","filename":"main.py","patch":[{"start1":45,"length1":39,"diffs":[[1,"# FAMILY SKI TRIP! — Level 1: Bunny Slope\n"]]},{"start1":232,"length1":101,"diffs":[[1,""]]},{"start1":1519,"length1":0,"diffs":[[1,"# Down arrow: crouched racing tuck + speed lines\n"]]},{"start1":1987,"length1":0,"diffs":[[1,"# Up arrow: snowplow (\"pizza\" wedge) + snow spray\n"]]},{"start1":2456,"length1":2616,"diffs":[[1,""]]},{"start1":3691,"length1":0,"diffs":[[1,"# Checkered finish line banner (160x8)\n"]]},{"start1":3937,"length1":0,"diffs":[[1,"NORMAL_SPEED = 70\nSLOW_SPEED = 35\nFAST_SPEED = 125\n"]]},{"start1":4005,"length1":136,"diffs":[[1,"LEVEL_1_GOAL = 300  # Ski 300 meters to reach the finish line\n"]]},{"start1":4068,"length1":